# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Docker image used for isolated execution
SANDBOX_IMAGE=sandbox-worker:latest

# Max parallel sandbox workers (tune to your CPU/RAM)
MAX_WORKERS=3

# Seconds before ML analysis times out
ML_TIMEOUT=30

# ── API ───────────────────────────────────────────────────────────────────────
# Note: the API port (8000) is currently hardcoded in docker-compose.yml's
# `ports:` mapping and uvicorn's --port flag — there's no API_PORT env var
# wired up yet. Change both places if you need a different port.

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
