# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Docker image used for isolated execution
SANDBOX_IMAGE=sandbox-worker:latest

# Max parallel sandbox workers (tune to your CPU/RAM)
MAX_WORKERS=3

# Seconds before ML analysis times out
ML_TIMEOUT=30

# ── API ───────────────────────────────────────────────────────────────────────
# Port the FastAPI server listens on
API_PORT=8000

# ── Frontend ──────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
